# ── Base de datos (Railway la inyecta automáticamente) ──
DATABASE_URL="postgresql://usuario:password@localhost:5432/finanzaspro"

# ── Auth ──
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="cambia-esto-por-un-secreto-largo"

# URL pública de la app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email (recuperación de contraseña) ──
# Sin estas variables el enlace de recuperación se imprime en los logs del
# servidor y en /tmp/reset-mail.log (fallback para dev/piloto).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="FinanzasPro <no-responder@tu-dominio.com>"

# ── Purga automática de datos antiguos ──
# La rutina siempre puede ejecutarse a mano (POST /api/admin/data-cleanup o
# `npx tsx scripts/cleanup.ts`). Con AUTO_CLEANUP="true" el servidor además la
# corre en segundo plano cada CLEANUP_INTERVAL_SECONDS (mínimo 3600, por
# defecto 21600 = 6 h). Borra audit_logs > AUDIT_RETENTION_DAYS, tokens de
# reset usados/vencidos y devices inactivos > DEVICE_INACTIVE_DAYS.
AUTO_CLEANUP="false"
CLEANUP_INTERVAL_SECONDS="21600"
AUDIT_RETENTION_DAYS="365"
DEVICE_INACTIVE_DAYS="180"
